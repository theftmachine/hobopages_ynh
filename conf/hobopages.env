# HoboPages configuration, generated by the YunoHost package.
# After editing:  systemctl restart __APP__

HOBOPAGES_HOST=127.0.0.1
HOBOPAGES_PORT=__PORT__
HOBOPAGES_BASE_URL=https://__DOMAIN__
HOBOPAGES_DATA_DIR=__DATA_DIR__

# The admin password lives in its own root-owned file so it never has to be
# quoted through systemd.
HOBOPAGES_ADMIN_PASSWORD_FILE=__INSTALL_DIR__/admin_password

# Releases kept per site, for rollback.
HOBOPAGES_MAX_RELEASES=10

# Admin session lifetime in hours (14 days).
HOBOPAGES_SESSION_HOURS=336

HOBOPAGES_COOKIE_SECURE=true
